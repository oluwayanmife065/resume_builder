#set page(
  paper: "us-letter",
  margin: (x: 1.4cm, top: 1.3cm, bottom: 1.3cm),
)

#set text(
  font: ("Liberation Sans", "PT Sans", "DejaVu Sans", "Helvetica", "Arial"),
  size: 9.5pt,
  fill: rgb("#111827"),
  lang: "en",
)

#set par(
  justify: false,
  leading: 0.52em,
)

// Section header styling with neat underline
#let section-heading(title) = {
  v(7pt)
  text(11pt, weight: "bold", tracking: 0.05em)[#upper(title)]
  v(-3pt)
  line(length: 100%, stroke: 0.75pt + rgb("#cbd5e1"))
  v(2pt)
}

// Experience & Project header entry with 2-column grid
#let entry-header(left-bold, left-italic, right-normal, right-italic) = {
  grid(
    columns: (1fr, auto),
    align: (left, right),
    [
      #text(weight: "bold")[#left-bold]
      #if left-italic != "" [ | #text(style: "italic")[#left-italic] ]
    ],
    [
      #text(fill: rgb("#475569"))[#right-normal]
      #if right-italic != "" [ | #text(style: "italic", fill: rgb("#475569"))[#right-italic] ]
    ],
  )
}

// ==========================================
// HEADER
// ==========================================
#align(center)[
  #text(18pt, weight: "bold", fill: rgb("#0f172a"))[{{ resume.contact.full_name | escape_typst }}]
  
  #v(2pt)
  #text(10.5pt, weight: "medium", fill: rgb("#2563eb"))[{{ resume.target_role | escape_typst }}]
  
  #v(3pt)
  #text(8.5pt, fill: rgb("#475569"))[
    {{ resume.contact.location | escape_typst }}
    {% if resume.contact.phone %} • {{ resume.contact.phone | escape_typst }}{% endif %}
    {% if resume.contact.email %} • #link("mailto:{{ resume.contact.email }}")[{{ resume.contact.email }}]{% endif %}
    {% if resume.contact.linkedin_url %} • #link("{{ resume.contact.linkedin_url }}")[LinkedIn]{% endif %}
    {% if resume.contact.github_url %} • #link("{{ resume.contact.github_url }}")[GitHub]{% endif %}
    {% if resume.contact.portfolio_url %} • #link("{{ resume.contact.portfolio_url }}")[Portfolio]{% endif %}
  ]
]

#v(3pt)

// ==========================================
// PROFESSIONAL SUMMARY
// ==========================================
#section-heading("Professional Summary")
#text(size: 9pt)[{{ resume.summary | escape_typst }}]

// ==========================================
// EDUCATION
// ==========================================
#section-heading("Education")
{% for edu in resume.education %}
#entry-header("{{ edu.institution | escape_typst }}", "{{ edu.degree | escape_typst }} in {{ edu.field_of_study | escape_typst }}", "{{ edu.location | default('', true) | escape_typst }}", "{{ edu.graduation_date | escape_typst }}")
{% if edu.gpa %}
#v(1pt)
#text(size: 8.5pt)[• GPA: {{ edu.gpa | escape_typst }}]
{% endif %}
{% if edu.highlights %}
#v(1pt)
{% for h in edu.highlights %}
#text(size: 8.5pt)[• {{ h | escape_typst }}] \
{% endfor %}
{% endif %}
#v(2pt)
{% endfor %}

// ==========================================
// TECHNICAL SKILLS
// ==========================================
#section-heading("Technical Skills")
{% for cat in resume.skills %}
#text(weight: "bold")[{{ cat.category_name | escape_typst }}:] #text(fill: rgb("#1f2937"))[{{ cat.skills | join(", ") | escape_typst }}] \
{% endfor %}

// ==========================================
// EXPERIENCE
// ==========================================
#section-heading("Experience")
{% for exp in resume.experiences %}
#entry-header("{{ exp.company | escape_typst }}", "{{ exp.title | escape_typst }}", "{{ exp.location | escape_typst }}", "{{ exp.date_range | escape_typst }}")
#v(1pt)
{% for bullet in exp.bullets %}
- {{ bullet | escape_typst }}
{% endfor %}
{% if exp.technologies %}
#v(-2pt)
#text(size: 8pt, style: "italic", fill: rgb("#64748b"))[Technologies: {{ exp.technologies | join(", ") | escape_typst }}]
{% endif %}
#v(3pt)
{% endfor %}

// ==========================================
// PROJECTS
// ==========================================
{% if resume.projects %}
#section-heading("Projects")
{% for proj in resume.projects %}
#entry-header("{{ proj.title | escape_typst }}", "{{ proj.role | default('', true) | escape_typst }}", "", "")
{% for bullet in proj.bullets %}
- {{ bullet | escape_typst }}
{% endfor %}
{% if proj.technologies %}
#v(-2pt)
#text(size: 8pt, style: "italic", fill: rgb("#64748b"))[Built with: {{ proj.technologies | join(", ") | escape_typst }}]
{% endif %}
#v(2pt)
{% endfor %}
{% endif %}

